// Inventra AI — Prisma schema
// AI-powered inventory copilot for Cambodian SMEs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A business owner / shop account
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  businessName String
  avatarUrl   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    Product[]
}

/// A product / SKU in the store catalog
model Product {
  id             String           @id @default(cuid())
  userId         String
  name           String
  category       String
  sku            String?
  stockQuantity  Int
  dailySales     Float            @default(0) // authoritative daily unit velocity from import
  sellingPrice   Float
  costPrice      Float
  reorderPoint   Int              @default(10)
  unit           String           @default("unit")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales          Sale[]
  recommendations Recommendation[]
}

/// A sales transaction line (one product, a quantity sold on a given day)
model Sale {
  id        String   @id @default(cuid())
  productId String
  quantity  Int
  date      DateTime
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, date])
}

/// AI-generated recommendation for a product
model Recommendation {
  id                     String   @id @default(cuid())
  productId              String
  revenueAtRisk          Float
  suggestedOrderQuantity Int
  confidenceScore        Float
  priority               String   // CRITICAL | HIGH | MEDIUM | LOW
  reason                 String
  generatedAt            DateTime @default(now())
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// A Copilot conversation thread
model ChatSession {
  id        String        @id @default(cuid())
  title     String        @default("New conversation")
  language  String        @default("en") // en | km
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  @@index([updatedAt])
}

/// A single Copilot message (user or assistant), with structured payload
model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  role         String      // user | assistant
  content      String      // clean markdown (structured JSON tail stripped out)
  insightCards Json?       // CopilotInsightCards
  reorder      Json?       // CopilotReorderItem[]
  language     String      @default("en")
  createdAt    DateTime    @default(now())
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// One business-data import batch (CSV / Excel upload)
model ImportBatch {
  id        String   @id @default(cuid())
  fileName  String
  rowCount  Int
  createdAt DateTime @default(now())
}

/// A saved what-if scenario from the Scenario Simulator
model Scenario {
  id        String   @id @default(cuid())
  name      String
  params    Json     // ScenarioParams
  result    Json     // SimulationResult
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Per-action status for the AI Action Center (keyed by a stable action identity)
model ActionState {
  id          String   @id @default(cuid())
  actionKey   String   @unique
  status      String   @default("open") // open | saved | completed | dismissed
  note        String?
  impactValue Float    @default(0)
  category    String   @default("")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@index([status])
}
