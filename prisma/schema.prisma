// Inventra AI — Prisma schema
// AI-powered inventory copilot for Cambodian SMEs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// A business owner / shop account. Created by Auth.js on first Google sign-in.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  businessName  String?
  emailVerified DateTime?
  image         String?
  avatarUrl     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  products      Product[]
  chatSessions  ChatSession[]
  importBatches ImportBatch[]
  scenarios     Scenario[]
  actionStates  ActionState[]
  snapshot      Snapshot?
}

/// Auth.js — a linked OAuth account (Google).
model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String?
  access_token             String?
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String?
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Auth.js — a database session (unused with the JWT strategy, but the adapter requires the model).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Auth.js — email verification token (unused with OAuth-only, but the adapter requires the model).
model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/// A product / SKU in the store catalog
model Product {
  id             String           @id @default(cuid())
  userId         String
  name           String
  category       String
  canonicalName  String           @default("") // normalised English name — internal matching / analytics only
  aliases        String[]         @default([]) // every spelling seen for this product
  sku            String?
  productCode    String?          // original code from the source file (falls back to sku)
  brand          String?          // recognised brand
  barcode        String?          // reserved for future POS / barcode phases
  confidenceScore Float?          @default(1) // 0..1 — recognition confidence
  isAutoGenerated Boolean         @default(true) // catalog entry built by recognition, not entered by hand
  recognitionMethod String        @default("") // RecognitionMethod captured at import (transparency only)
  recognitionReason String        @default("") // plain-language "how this was recognised", captured at import
  stockQuantity  Int
  dailySales     Float            @default(0) // authoritative daily unit velocity from import
  sellingPrice   Float
  costPrice      Float
  reorderPoint   Int              @default(10)
  unit           String           @default("unit")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sales          Sale[]
  recommendations Recommendation[]

  @@index([userId])
}

/// A sales transaction line (one product, a quantity sold on a given day)
model Sale {
  id        String   @id @default(cuid())
  productId String
  quantity  Int
  date      DateTime
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, date])
}

/// AI-generated recommendation for a product
model Recommendation {
  id                     String   @id @default(cuid())
  productId              String
  revenueAtRisk          Float
  suggestedOrderQuantity Int
  confidenceScore        Float
  priority               String   // CRITICAL | HIGH | MEDIUM | LOW
  reason                 String
  generatedAt            DateTime @default(now())
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

/// A Copilot conversation thread
model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("New conversation")
  language  String        @default("en") // en | km
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

/// A single Copilot message (user or assistant), with structured payload
model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  role         String      // user | assistant
  content      String      // clean markdown (structured JSON tail stripped out)
  insightCards Json?       // CopilotInsightCards
  reorder      Json?       // CopilotReorderItem[]
  language     String      @default("en")
  createdAt    DateTime    @default(now())
  session      ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/// One business-data import batch (CSV / Excel upload)
model ImportBatch {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  rowCount  Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// A saved what-if scenario from the Scenario Simulator
model Scenario {
  id        String   @id @default(cuid())
  userId    String
  name      String
  params    Json     // ScenarioParams
  result    Json     // SimulationResult
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Precomputed analysis + AI outputs — one row per user, rebuilt on data change.
model Snapshot {
  id              String   @id @default(cuid())
  userId          String   @unique
  dataHash        String   @default("")
  business        String   @default("")
  productCount    Int      @default(0)
  analysis        Json
  brief           Json
  briefSource     String   @default("deterministic")
  actionDrafts    Json
  actionsBriefing String   @default("")
  briefingSource  String   @default("deterministic")
  copilotContext  Json
  promptBlock     String   @default("")
  aiStale         Boolean  @default(true)
  computedAt      DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Per-action status for the AI Action Center (keyed by a stable action identity)
model ActionState {
  id          String   @id @default(cuid())
  userId      String
  actionKey   String
  status      String   @default("open") // open | saved | completed | dismissed
  note        String?
  impactValue Float    @default(0)
  category    String   @default("")
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, actionKey])
  @@index([userId, status])
}
