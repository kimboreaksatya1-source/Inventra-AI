# Copy to .env and fill in real values. .env is gitignored.

# PostgreSQL — local Docker, Neon, Supabase, etc.
# After setting this: bun run db:push && bun run db:generate
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/inventra?schema=public"

# AI provider (DeepSeek — OpenAI-compatible). Optional:
# the Business Brief falls back to a deterministic report when this is unset.
DEEPSEEK_API_KEY=""

# Auth.js v5 — Google OAuth (required).
#   AUTH_SECRET:  `bunx auth secret`  (or `openssl rand -base64 33`)
#   AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET: Google Cloud console → APIs & Services →
#     Credentials → Create OAuth client ID → Web application.
#     Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#     (add your production URL's /api/auth/callback/google too)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_TRUST_HOST=true
